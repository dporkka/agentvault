{
  "name": "agentvault-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && cd dist && zip -r ../agentvault-extension-v$npm_package_version.zip ."
  },
  "dependencies": {
    "@agentvault/contract": "file:../../packages/contract",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^8.1.3",
    "vitest": "^3.0.0"
  }
}
